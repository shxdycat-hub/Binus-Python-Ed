        "FILENAME = \"Biodata.txt\"\n",
        "\n",
        "\n",
        "def get_user_input():\n",
        "    data = {\n",
        "        \"Name\": input(\"whats yo name: \").strip(),\n",
        "        \"Age\": input(\"how old u is: \").strip(),\n",
        "        \"Address\": input(\"what yo address: \").strip(),\n",
        "        \"Email\": input(\"yo email?: \").strip(),\n",
        "    }\n",
        "    return data\n",
        "\n",
        "\n",
        "def write_biodata(data, filename=FILENAME):\n",
        "    try:\n",
        "        with open(filename, \"w\") as file:\n",
        "            for key, value in data.items():\n",
        "                file.write(f\"{key}: {value}\\n\")\n",
        "        print(f\"\\nBiodata entered to '{filename}'.\")\n",
        "    except IOError as error:\n",
        "        print(f\"writin failed yo: {error}\")\n",
        "\n",
        "\n",
        "def read_biodata(filename=FILENAME):\n",
        "    try:\n",
        "        with open(filename, \"r\") as file:\n",
        "            content = file.read()\n",
        "        print(f\"\\n--- Contents of '{filename}' ---\")\n",
        "        print(content)\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: '{filename}' beeth invisible.\")\n",
        "    except IOError as error:\n",
        "        print(f\"couldnt read it: {error}\")\n",
        "\n",
        "\n",
        "def main():\n",
        "    data = get_user_input()\n",
        "    write_biodata(data)\n",
        "    read_biodata()\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
